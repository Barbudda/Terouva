{
  "manifest_version": 3,
  "name": "Terouva — Watch LBC",
  "short_name": "Terouva",
  "version": "0.2.0",
  "description": "Surveille tes pages de recherche Leboncoin en temps réel et envoie chaque nouvelle annonce à l'app Terouva.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Terouva — Capture & surveillance",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "notifications"],
  "host_permissions": [
    "https://www.leboncoin.fr/*",
    "https://leboncoin.fr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/ad/*",
        "https://www.leboncoin.fr/*/itemId-*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.leboncoin.fr/recherche*",
        "https://www.leboncoin.fr/locations*",
        "https://www.leboncoin.fr/c/locations*",
        "https://www.leboncoin.fr/colocations*"
      ],
      "js": ["content/watch.js"],
      "run_at": "document_idle"
    }
  ]
}
