{
  "manifest_version": 3,
  "name": "Terouva — Capture LBC",
  "short_name": "Terouva",
  "version": "0.1.0",
  "description": "Capture une annonce Leboncoin et envoie-la à l'app Terouva en un clic.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Terouva — Capturer l'annonce",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://www.leboncoin.fr/*",
    "https://leboncoin.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/ad/*",
        "https://www.leboncoin.fr/*/itemId-*",
        "https://www.leboncoin.fr/locations/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
