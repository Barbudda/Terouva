# =====================================================================
# Terouva monorepo — root .gitignore
# Apps live under apps/{desktop,web,extension}. This file covers all.
# =====================================================================

# --- Secrets (never commit) ---
.env
.env.local
.env.*.local
!.env.example

# --- Machine-specific Claude Code MCP config ---
# Contains absolute paths (Obsidian vault, etc). Each dev should
# copy .mcp.json.example → .mcp.json and adjust locally.
.mcp.json
mcp.config.json

# --- Node ---
node_modules/
**/node_modules/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build outputs ---
dist/
out/
.next/
.vite/
.turbo/
**/dist/
**/out/
**/.next/
**/.vite/

# --- TypeScript build cache ---
*.tsbuildinfo
**/*.tsbuildinfo

# --- Tauri / Rust ---
**/target/
**/src-tauri/gen/
# Cargo.lock is committed for the desktop app (binary, not library) — required by CI.

# --- Cargo local config (machine-specific target-dir override) ---
.cargo/config.toml
**/.cargo/config.toml

# --- SQLite local DBs ---
*.db
*.db-journal
*.db-shm
*.db-wal
data.db

# --- Vite generated declarations / JS for config files ---
vite.config.d.ts
vite.config.js

# --- Ruflo runtime artifacts (local cache, sessions, logs) ---
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/cache/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Vercel ---
.vercel/

.vercel

# --- Captures et journaux du navigateur de test (Playwright MCP) ---
.playwright-mcp/

# Vidéos de promotion : regénérables avec « npm run promo ».
# Le source (scripts/promo/) est versionné, pas les fichiers de sortie.
/promo/*.mp4

.env*.local

# Dossiers de build mis de côté quand OneDrive corrompt .next (à supprimer à la main).
apps/web/.next-corrompu-*

# --- Runtime du démon ruflo (claude-flow) ---
# État et métriques réécrits à chaque passage du démon : du bruit dans chaque
# diff, aucune valeur dans l'historique. La configuration (config.yaml,
# CAPABILITIES.md) reste versionnée.
.claude-flow/daemon-state.json
.claude-flow/daemon.pid
.claude-flow/metrics/
.claude-flow/security/

# Copie de sauvegarde écrite par BONDS ; .mcp.json lui-même est déjà ignoré.
.mcp.json.bak

# --- Loadout BONDS (copies de skills et d'agents tiers, ~31 Mo) ---
# Ce qui est installé, avec sa source et son hash, est tracé dans
# bonds-lock.json (versionné) ; « /bonds update » réinstalle ces copies à
# l'identique. On versionne le lock, pas 1 600 fichiers copiés.
.claude/design-md/
